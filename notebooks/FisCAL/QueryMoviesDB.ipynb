      "source": [
        "# Query moviesDB\n",
        "\n",
        "Read up to 100 rows from `dbo.moviesDB` in the `sqldedpool1` dedicated SQL pool using the Azure Synapse Spark connector."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "movies_df = spark.read.synapsesql(\"sqldedpool1.dbo.moviesDB\")\n",
        "display(movies_df.limit(100))"
      ]
    }
